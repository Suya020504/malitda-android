+def meaning_prompt(profile_id, expected_revision, meaning, db_path=None):
+    """Student's saved style + a meaning sentence registered by the supporter (Malitda v2).
+
+    Unlike fixed scenes, the result is returned to the app only and is not stored as a
+    profile candidate: the app saves it locally and the student must confirm it first.
+    """
+    profile = get_profile(profile_id, db_path)
+    if profile['revision'] != expected_revision:
+        raise HTTPException(409, '표현 방식이 변경되었습니다. 최신 설정을 확인하세요.')
+    style = profile['style_id']
+    reference = ASSETS.get(style, {}).get('walk', '/assets/style-anchor.jpg')
+    anchor = ROOT / reference.lstrip('/')
+    if not anchor.is_file():
+        anchor = ROOT / 'assets' / 'style-anchor.jpg'
+    prompt = ('Create one visual communication card candidate. Keep the main subject centered so the image still '
+              'reads when cropped to a wide 3:2 card. No text, no letters, '
+              'no numbers, no logos, no speech bubbles. A person who cannot read must understand the meaning '
+              'from the picture alone. Keep the scene calm and friendly; avoid dark, scary or injury scenes. '
+              'If people appear, keep faces simple. The supplied reference depicts fictional people, not a real student. '
+              f"Target representation: {STYLE_MAP[style]['prompt']} "
+              'Use the reference only for the visual medium and mood; do not copy its scene. '
+              'Meaning to depict (Korean, written by the supporter): ' + meaning)
+    return {'prompt': prompt, 'anchor_path': anchor, 'style_id': style,
+            'revision': profile['revision'], 'character_id': profile['character_id']}
+
+
 class StyleSelection(BaseModel):
